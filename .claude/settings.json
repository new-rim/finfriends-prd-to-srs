{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git switch:*)",
      "Bash(git add:*)",
      "Bash(git stash list)",
      "Bash(git ls-files:*)",
      "Bash(git ls-remote:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh label list:*)",
      "Bash(gh project item-list:*)",
      "Bash(gh project field-list:*)",
      "Bash(gh api graphql:*)",
      "Bash(gh auth status)",
      "Bash(npm run lint:*)",
      "Bash(npm run test:*)",
      "Bash(npm run prebuild)",
      "Bash(npm run build)",
      "Bash(npm test:*)",
      "Bash(npx vitest:*)",
      "Bash(npx tsc:*)",
      "Bash(npx playwright test:*)",
      "Bash(npx prisma validate)",
      "Bash(npx prisma format)",
      "Bash(npx prisma generate)",
      "Bash(npx prisma migrate status)",
      "Bash(npx prisma migrate dev --create-only:*)",
      "Bash(supabase status)",
      "Bash(supabase start)",
      "Bash(supabase stop)",
      "Bash(supabase db diff:*)",
      "Bash(python3 scripts/github/project_setup.py)",
      "Bash(python3 scripts/github/project_views.py)",
      "Bash(npx skills list)",
      "Bash(npx skills ls)"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(gh pr create:*)",
      "Bash(gh issue edit:*)",
      "Bash(gh issue create:*)",
      "Bash(npx prisma migrate deploy:*)",
      "Bash(npx skills add:*)",
      "Bash(npx skills remove:*)",
      "Bash(npx skills update:*)",
      "Bash(vercel env:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fd:*)",
      "Bash(npx prisma db push:*)",
      "Bash(npx prisma migrate reset:*)",
      "Bash(supabase db reset:*)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Read(./.env*.local)"
    ]
  }
}
